{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hiveframe.dev/schemas/m1-b0-locality-opportunity/v0.1.0.schema.json",
  "title": "HIVEFRAME M1-B0 model-free locality opportunity result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_revision",
    "run_kind",
    "decision",
    "inputs",
    "surface",
    "cost_profiles",
    "parity",
    "local_artifact_bundle",
    "unavailable_memory_metrics",
    "claim_boundary",
    "summary_digest"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "protocol_revision": {"const": "m1-b0-v1"},
    "run_kind": {"const": "m1_b0_model_free_locality_opportunity"},
    "decision": {
      "enum": [
        "M1_B0_LOCALITY_SURFACE_MEASURED",
        "M1_B0_REFINEMENT_REQUIRED",
        "M1_B0_BLOCKED"
      ]
    },
    "inputs": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {"$ref": "#/$defs/input"}
    },
    "surface": {"type": "object"},
    "cost_profiles": {"type": "object"},
    "parity": {
      "type": "object",
      "required": ["passed", "clip_format_pairs", "mismatches"],
      "properties": {
        "passed": {"type": "boolean"},
        "clip_format_pairs": {"type": "integer", "minimum": 0},
        "mismatches": {"type": "array"}
      }
    },
    "local_artifact_bundle": {"$ref": "#/$defs/artifact"},
    "unavailable_memory_metrics": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/unavailable"}
    },
    "claim_boundary": {"$ref": "#/$defs/claimBoundary"},
    "summary_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clip_id", "asset_id", "frames", "frame_pairs", "width", "height", "fps", "derivative_sha256", "decoded_logical_bytes", "hash_verified"],
      "properties": {
        "clip_id": {"pattern": "^c(0[1-9]|1[0-2])$"},
        "asset_id": {"type": "string", "pattern": "^approved-asset:m1-a2/"},
        "frames": {"type": "integer", "minimum": 2},
        "frame_pairs": {"type": "integer", "minimum": 1},
        "width": {"const": 832},
        "height": {"const": 480},
        "fps": {"const": 16},
        "derivative_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "decoded_logical_bytes": {"type": "integer", "minimum": 1},
        "hash_verified": {"const": true}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "bytes", "sha256", "tracked_by_git"],
      "properties": {
        "asset_id": {"type": "string", "pattern": "^approved-asset:m1-a2/m1_b0_locality/"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "tracked_by_git": {"const": false}
      }
    },
    "unavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "status", "reason", "method"],
      "properties": {
        "value": {"type": "null"},
        "status": {"const": "unavailable"},
        "reason": {"type": "string", "minLength": 1},
        "method": {"const": "not measured"}
      }
    },
    "claimBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_runs", "cuda_runs", "gpu_runs", "backend_integration_runs",
        "selective_compute_runs", "vram_measurement_runs",
        "product_speedup_results", "safe_skip_truth_count",
        "verified_compute_relevance_oracles"
      ],
      "properties": {
        "model_runs": {"const": 0},
        "cuda_runs": {"const": 0},
        "gpu_runs": {"const": 0},
        "backend_integration_runs": {"const": 0},
        "selective_compute_runs": {"const": 0},
        "vram_measurement_runs": {"const": 0},
        "product_speedup_results": {"const": 0},
        "safe_skip_truth_count": {"const": 0},
        "verified_compute_relevance_oracles": {"const": 0}
      }
    }
  }
}

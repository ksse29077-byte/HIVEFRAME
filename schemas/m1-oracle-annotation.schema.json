{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hiveframe.dev/schemas/m1-oracle-annotation.schema.json",
  "title": "HIVEFRAME M1 human-reviewed oracle annotations",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "annotation_version", "annotations"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "annotation_version": {"type": "string", "minLength": 1},
    "annotations": {"type": "array", "items": {"$ref": "#/$defs/annotation"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "frameInterval": {
      "type": "array", "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 1}],
      "items": false, "minItems": 2, "maxItems": 2
    },
    "geometry": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["type", "xywh"], "properties": {"type": {"const": "bbox"}, "xywh": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}], "items": false, "minItems": 4, "maxItems": 4}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "points"], "properties": {"type": {"const": "polygon"}, "points": {"type": "array", "minItems": 3, "items": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "items": false, "minItems": 2, "maxItems": 2}}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "size", "counts", "starts_with"], "properties": {"type": {"const": "rle"}, "size": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}], "items": false, "minItems": 2, "maxItems": 2}, "counts": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}}, "starts_with": {"enum": [0, 1]}}}
      ]
    },
    "region": {
      "type": "object", "additionalProperties": false,
      "required": ["region_id", "state", "geometry", "object_ids", "change_causes", "confidence", "semantic_ref", "semantic_hash"],
      "properties": {
        "region_id": {"type": "string", "minLength": 1},
        "state": {"enum": ["dirty", "stable", "uncertain", "preserve"]},
        "geometry": {"$ref": "#/$defs/geometry"},
        "object_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "change_causes": {"type": "array", "uniqueItems": true, "items": {"enum": ["object_motion", "camera_motion", "occlusion", "disocclusion", "scene_cut", "lighting", "shadow", "reflection", "mirror", "hair", "water", "smoke", "compression", "noise", "decoder", "preserve"]}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "semantic_ref": {"type": "string", "minLength": 1},
        "semantic_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "transition": {
      "type": "object", "additionalProperties": false,
      "required": ["transition_id", "frame_interval", "scene_cut", "camera_motion", "full_reobserve", "invalidated_object_ids", "regions"],
      "properties": {
        "transition_id": {"type": "string", "minLength": 1},
        "frame_interval": {"$ref": "#/$defs/frameInterval"},
        "scene_cut": {"type": "boolean"},
        "camera_motion": {"enum": ["none", "pan", "zoom", "shake", "mixed", "uncertain"]},
        "full_reobserve": {"type": "boolean"},
        "invalidated_object_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "regions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/region"}}
      }
    },
    "annotation": {
      "type": "object", "additionalProperties": false,
      "required": ["clip_id", "source_sha256", "derivative_sha256", "canvas", "frame_count", "object_catalog", "semantic_payloads", "transitions", "annotation_provenance", "annotation_method", "review_protocol", "review_status", "confidence", "disagreement", "artifact_digest"],
      "properties": {
        "clip_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "derivative_sha256": {"$ref": "#/$defs/sha256"},
        "canvas": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}], "items": false, "minItems": 2, "maxItems": 2},
        "frame_count": {"type": "integer", "minimum": 2},
        "object_catalog": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["object_id", "identity_scope"], "properties": {"object_id": {"type": "string", "minLength": 1}, "identity_scope": {"type": "string", "minLength": 1}}}},
        "semantic_payloads": {"type": "object", "additionalProperties": {"type": "object"}},
        "transitions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/transition"}},
        "annotation_provenance": {"type": "string", "minLength": 1},
        "annotation_method": {"type": "string", "minLength": 1},
        "review_protocol": {"enum": ["independent_multi_reviewer", "time_separated_blind_self_review"]},
        "review_status": {"enum": ["verified", "pending", "rejected"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "disagreement": {"type": "array", "items": {"type": "object"}},
        "artifact_digest": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}

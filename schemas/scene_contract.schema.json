{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hiveframe.dev/schemas/scene-contract/v0.schema.json",
  "title": "HIVEFRAME SceneContract v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scene_id", "canvas", "objects", "constraints"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "scene_id": { "type": "string", "minLength": 1 },
    "seed": { "type": "integer", "minimum": 0 },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "frames", "fps"],
      "properties": {
        "width": { "type": "integer", "minimum": 64 },
        "height": { "type": "integer", "minimum": 64 },
        "frames": { "type": "integer", "minimum": 1 },
        "fps": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "write_permission"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "identity_anchor": { "type": "string" },
          "depth_order": { "type": "integer" },
          "write_permission": { "enum": ["preserve", "modify", "delete", "create"] },
          "box_xywh_normalized": {
            "type": "array",
            "prefixItems": [
              { "type": "number", "minimum": 0, "maximum": 1 },
              { "type": "number", "minimum": 0, "maximum": 1 },
              { "type": "number", "minimum": 0, "maximum": 1 },
              { "type": "number", "minimum": 0, "maximum": 1 }
            ],
            "items": false
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "target_ids", "tolerance"],
        "properties": {
          "kind": {
            "enum": ["count", "distance", "size", "landmark", "depth", "symmetry", "preserve"]
          },
          "target_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "value": {},
          "tolerance": { "type": "number", "minimum": 0 }
        }
      }
    }
  }
}

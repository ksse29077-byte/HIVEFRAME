{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hiveframe.dev/schemas/h3_generation_request.schema.json",
  "title": "HIVEFRAME MiniMax H3 Generation Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["model", "profile", "content", "resolution", "duration_seconds", "ratio", "requested_ratio", "aigc_watermark"],
  "properties": {
    "model": {"const": "MiniMax-H3"},
    "profile": {"enum": ["standard", "fast_2m_candidate"]},
    "content": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/content_item"},
      "contains": {
        "type": "object",
        "required": ["type", "text"],
        "properties": {"type": {"const": "text"}, "text": {"type": "string", "minLength": 1}}
      }
    },
    "resolution": {"enum": ["768P", "2K"]},
    "duration_seconds": {"type": "integer", "minimum": 4, "maximum": 15},
    "ratio": {"enum": ["adaptive", "21:9", "16:9", "4:3", "1:1", "3:4", "9:16"]},
    "requested_ratio": {"enum": ["adaptive", "21:9", "16:9", "4:3", "1:1", "3:4", "9:16"]},
    "aigc_watermark": {"type": "boolean"}
  },
  "$defs": {
    "content_item": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "text"],
          "properties": {"type": {"const": "text"}, "text": {"type": "string", "minLength": 1}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "role", "asset_id"],
          "properties": {
            "type": {"const": "image"},
            "role": {"enum": ["first_frame", "last_frame", "reference_image"]},
            "asset_id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,80}$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "role", "asset_id"],
          "properties": {
            "type": {"const": "video"},
            "role": {"const": "reference_video"},
            "asset_id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,80}$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "role", "asset_id"],
          "properties": {
            "type": {"const": "audio"},
            "role": {"const": "reference_audio"},
            "asset_id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,80}$"}
          }
        }
      ]
    }
  }
}
